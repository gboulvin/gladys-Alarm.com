                "es": "Fuga de agua"
              }
            },
            {
              "value": "smoke",
              "label": {
                "en": "Smoke",
                "fr": "Fumée",
                "de": "Rauch",
                "es": "Humo"
              }
            },
            {
              "value": "co",
              "label": {
                "en": "Carbon monoxide",
                "fr": "Monoxyde de carbone",
                "de": "Kohlenmonoxid",
                "es": "Monóxido de carbono"
              }
            },
            {
              "value": "glass_break",
              "label": {
                "en": "Glass break",
                "fr": "Bris de vitre",
                "de": "Glasbruch",
                "es": "Rotura de cristal"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "kind",
          "type": "string",
          "label": {
            "en": "Detection",
            "fr": "Détection",
            "de": "Erkennung",
            "es": "Detección"
          }
        },
        {
          "key": "sensor_name",
          "type": "string",
          "label": {
            "en": "Sensor name",
            "fr": "Nom du capteur",
            "de": "Name des Sensors",
            "es": "Nombre del sensor"
          }
        }
      ]
    },
    {
