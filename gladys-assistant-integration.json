              }
            },
            {
              "value": "unlocked",
              "label": {
                "en": "Unlocked",
                "fr": "Déverrouillée",
                "de": "Entriegelt",
                "es": "Desbloqueada"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "state",
          "type": "string",
          "label": {
            "en": "New state",
            "fr": "Nouvel état",
            "de": "Neuer Zustand",
            "es": "Nuevo estado"
          }
        },
        {
          "key": "lock_name",
          "type": "string",
          "label": {
            "en": "Lock name",
            "fr": "Nom de la serrure",
            "de": "Name des Schlosses",
            "es": "Nombre de la cerradura"
          }
        }
      ]
    },
    {
      "key": "low_battery",
      "label": {
        "en": "Alarm.com: low battery",
        "fr": "Alarm.com : pile faible",
        "de": "Alarm.com: Batterie schwach",
        "es": "Alarm.com: batería baja"
      },
      "description": {
        "en": "A sensor or a lock reports a low battery.",
        "fr": "Un capteur ou une serrure signale une pile faible.",
        "de": "Ein Sensor oder ein Schloss meldet eine schwache Batterie.",
        "es": "Un sensor o una cerradura indica batería baja."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Dispositivo"
          },
