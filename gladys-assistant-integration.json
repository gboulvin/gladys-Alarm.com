      "label": {
        "en": "Alarm.com: lock locked or unlocked",
        "fr": "Alarm.com : serrure verrouillée ou déverrouillée",
        "de": "Alarm.com: Schloss ver- oder entriegelt",
        "es": "Alarm.com: cerradura bloqueada o desbloqueada"
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Lock",
            "fr": "Serrure",
            "de": "Schloss",
            "es": "Cerradura"
          },
          "required": false
        },
        {
          "key": "state",
          "type": "multi_select",
          "label": {
            "en": "New state",
            "fr": "Nouvel état",
            "de": "Neuer Zustand",
            "es": "Nuevo estado"
          },
          "options": [
            {
              "value": "locked",
              "label": {
                "en": "Locked",
                "fr": "Verrouillée",
                "de": "Verriegelt",
