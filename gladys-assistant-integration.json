            "fr": "Nom de l'appareil",
            "de": "Gerätename",
            "es": "Nombre del dispositivo"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "arm_system",
      "label": {
        "en": "Alarm.com: arm",
        "fr": "Alarm.com : armer",
        "de": "Alarm.com: scharf schalten",
        "es": "Alarm.com: armar"
      },
      "description": {
        "en": "Arms one partition, or every partition.",
        "fr": "Arme une partition, ou toutes les partitions.",
        "de": "Schaltet eine oder alle Partitionen scharf.",
        "es": "Arma una partición o todas."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Partition",
            "fr": "Partition",
            "de": "Partition",
            "es": "Partición"
          },
          "required": false,
          "description": {
            "en": "Leave empty to target every partition.",
            "fr": "Laissez vide pour viser toutes les partitions.",
            "de": "Leer lassen, um alle Partitionen anzusprechen.",
            "es": "Déjelo vacío para actuar sobre todas las particiones."
          }
        },
        {
          "key": "mode",
          "type": "select",
          "label": {
            "en": "Mode",
            "fr": "Mode",
            "de": "Modus",
            "es": "Modo"
          },
          "required": true,
          "default": "armed_away",
          "options": [
            {
              "value": "armed_away",
              "label": {
                "en": "Armed away",
                "fr": "Armée (absence)",
                "de": "Extern scharf",
                "es": "Armada ausente"
              }
            },
            {
              "value": "armed_stay",
              "label": {
                "en": "Armed stay",
                "fr": "Armée (présence)",
                "de": "Intern scharf",
                "es": "Armada en casa"
              }
            },
            {
              "value": "armed_night",
              "label": {
                "en": "Armed night",
                "fr": "Armée (nuit)",
                "de": "Nacht scharf",
                "es": "Armada noche"
              }
            }
          ]
        },
        {
          "key": "force_bypass",
          "type": "boolean",
          "label": {
            "en": "Bypass open sensors",
            "fr": "Ignorer les capteurs ouverts",
            "de": "Offene Sensoren überbrücken",
            "es": "Anular sensores abiertos"
          },
          "required": false,
          "default": false
        },
        {
          "key": "no_entry_delay",
          "type": "boolean",
          "label": {
            "en": "No entry delay",
            "fr": "Sans délai d'entrée",
            "de": "Ohne Eingangsverzögerung",
            "es": "Sin retardo de entrada"
          },
          "required": false,
          "default": false
        },
        {
          "key": "silent_arming",
          "type": "boolean",
          "label": {
            "en": "Silent arming",
            "fr": "Armement silencieux",
            "de": "Stilles Scharfschalten",
            "es": "Armado silencioso"
          },
          "required": false,
          "default": false
        }
      ],
      "outputs": [
        {
          "key": "success",
          "type": "boolean",
          "label": {
            "en": "Command sent",
            "fr": "Commande envoyée",
            "de": "Befehl gesendet",
            "es": "Orden enviada"
          }
        },
